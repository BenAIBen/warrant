# Warrant — example environment. Copy to .env and edit if you need non-defaults.
#
# There are NO credentials in this system. Warrant talks to one local SQLite
# file and nothing else; it makes no outbound network calls. Every variable
# below is a path, a port, a seed or a version string. If you ever find
# yourself adding an API key here, something has gone wrong with the design.

# Path to the SQLite database. Relative paths resolve from the repo root.
WARRANT_DB_PATH=data/unify.db

# Port for the HTTP server (app.py). If unset, the platform's PORT is used
# instead, and only if that is unset too does it fall back to 8000. Render and
# every other container host inject PORT.
WARRANT_PORT=8000

# Interface to bind. Default 127.0.0.1 — loopback only, so running app.py on a
# laptop exposes nothing to the local network. A container must set 0.0.0.0 or
# the platform's health check can never reach it.
WARRANT_BIND_HOST=127.0.0.1

# Comma-separated list of web origins allowed to call the /api routes from a
# browser. ORIGIN ONLY: scheme + host, no path, no repo name, no trailing
# slash. Compared as an exact string — no prefix or suffix matching.
# EMPTY MEANS NO CORS HEADERS ARE EMITTED AT ALL. That is deliberate: a backend
# that defaults to permissive is a backend that ships permissive.
# This is a configuration value, not a credential. There is nothing to
# authenticate to and nothing it grants.
WARRANT_ALLOWED_ORIGINS=

# 'ephemeral' or 'persistent'. On a host with no persistent disk set this to
# ephemeral and every read response carries a notice telling the rep, in plain
# words, that anything filed before the last restart is gone. Default is
# persistent, which is what a local checkout actually is.
WARRANT_PERSISTENCE=persistent

# Set to 1 to wipe an existing database and regenerate the corpus at boot.
# DESTRUCTIVE on a persistent disk: every dispute, pin and mute a rep filed is
# deleted. Leave it empty unless that is exactly what you want.
WARRANT_FORCE_RESEED=

# Seed for the data generator in seed_db.py. Reproducibility is a test
# assertion (DESIGN_SPEC.md §9.3 T01) — change this and T01 still passes, but
# the corpus changes.
WARRANT_SEED=20260811

# The evaluation instant used for ALL decay arithmetic and for expiry checks.
# ISO-8601 UTC, 'YYYY-MM-DDTHH:MM:SSZ'.
WARRANT_AS_OF=2026-08-11T09:00:00Z

# Written onto every score_run and every disagreement, so RevOps knows which
# weights a rep was reacting to.
WARRANT_RULESET_VERSION=warrant-v1.0.0
